[Unit]
Description=Private YouTube downloader Telegram bot
Wants=network-online.target telegram-bot-api.service
After=network-online.target telegram-bot-api.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
# Replace with the existing non-root account used for the manual launch.
User=REPLACE_WITH_SERVICE_USER
WorkingDirectory=/opt/youtube-downloader/downloader/app
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/youtube-downloader/runtime/node22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/youtube-downloader/downloader/app/.venv/bin/python /opt/youtube-downloader/downloader/app/bot.py
Restart=always
RestartSec=10
TimeoutStopSec=90
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=768M
MemoryMax=1G

[Install]
WantedBy=multi-user.target
